FMP_API_KEY=your_fmp_key_here   # optional — live comps via Financial Modeling Prep

# Optional — push coverage runs into a Notion database (agents/notion_sync.py)
NOTION_TOKEN=secret_xxx          # internal integration secret: notion.so/my-integrations
NOTION_DB_ID=your_database_id    # 32-char hash from the database URL
ATLAS_SITE_URL=https://your-site.vercel.app   # base URL of your deployed coverage site (for brief links)

# ── Layer 2 accounts (sign in with Google) — gates /full per user instead of one shared
# password. Set all three on Vercel (and here for local preview). When SUPABASE_JWT_SECRET
# is set it takes over from SITE_PASSWORD. URL + anon key are PUBLIC (baked into the site at
# build time); the JWT secret is sensitive and used only server-side in middleware.js.
SUPABASE_URL=https://your-project.supabase.co     # Supabase project URL (public)
SUPABASE_ANON_KEY=your_anon_public_key            # anon/public key (public)
SUPABASE_JWT_SECRET=your_project_jwt_secret       # Settings → API → JWT secret (SENSITIVE)
LOGIN_URL=https://alfred-analyst.com              # front door where sign-in lives; gate redirects misses here

# Legacy shared-password gate for /full — used only while SUPABASE_JWT_SECRET is unset.
# SITE_PASSWORD=choose_a_password
